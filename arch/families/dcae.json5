// diffusers AutoencoderDC decoder (Sana's dc-ae-f32c32): ResBlocks at the high resolutions,
// EfficientViT blocks (multi-scale ReLU linear attention + GLU MBConv) at the low ones,
// channel-wise RMSNorm with bias, nearest-interpolate up blocks with a repeat/pixel-shuffle
// shortcut. The network is affine-free: a pipeline decodes `z = latents / scaling`.
{
  family: "dcae",
  match: {diffusers_class: ["AutoencoderDC"]},
  pipeline: "diffusion",
  use_lib: ["vae"],
  config: {
    chans: "cfg.decoder_block_out_channels",
    layers: "cfg.decoder_layers_per_block",
    types: "cfg.decoder_block_types",
    levels: "len(chans)",
    latent_channels: "first(cfg.latent_channels, shape('decoder.conv_in.weight')[1])",
    head_dim: "first(cfg.attention_head_dim, 32)",
    scaling: "cfg.scaling_factor",
    factor: "2 ** (levels - 1)",
    eps: "1e-5",
  },
  checks: [
    {expr: "levels == 0 || len(layers) != levels || len(types) != levels || contains(layers, 0)",
     error: "DC-AE: decoder block config is missing or has empty levels"},
    {expr: "cfg.upsample_block_type != 'interpolate' || cfg.decoder_norm_types != 'rms_norm' || cfg.decoder_act_fns != 'silu'",
     error: "DC-AE: only interpolate upsampling, rms_norm and silu decoders are implemented (config: {first(cfg.upsample_block_type, 'none')}, {first(cfg.decoder_norm_types, 'none')}, {first(cfg.decoder_act_fns, 'none')})"},
    {expr: "cfg.scaling_factor == null", error: "DC-AE config: missing scaling_factor"},
  ],
  transforms: [
    // GLU MBConv point conv: nn.Conv2d(hidden, out, 1) kernels [c, c2/2, 1, 1] -> linear.
    {tensor: "{p:*}.conv_out.conv_point.weight", op: "conv_to_linear",
     when: "len(shape(fmt('{p}.conv_out.conv_point.weight'))) == 4"},
  ],
  constants: {
    "linear_attn.eps": {gen: "fill", args: {shape: [1], value: 1e-15}},
  },
  // The decoder-only port: img2img encoding is not implemented.
  ignore: ["encoder.*"],
  components: {
    // z [latent_channels, h, w] (already latents / scaling) -> image [3, h*f, w*f] in [-1, 1].
    decoder: {
      vars: ["h", "w"],
      inputs: [{name: "z", dtype: "f32", shape: ["latent_channels", "h", "w"]}],
      body: [
        {use: "conv", args: {w: "'decoder.conv_in'"}, in: ["i:z"], out: "x", name: "conv_in"},
        {use: "repeat_channels", args: {r: "shape('decoder.conv_in.weight')[0] // latent_channels"}, in: ["i:z"], out: "s", name: "in_shortcut"},
        {op: "Binary", args: {kind: "Add"}, in: ["x", "s"], out: "x", name: "in_res"},
        // diffusers runs reversed(up_blocks); every level but the deepest opens with an up block.
        {repeat: "j", count: "levels", body: [
          {let: {i: "levels - 1 - j", up: "j > 0 ? 1 : 0"}},
          {use: "dup_up", args: {p: "fmt('decoder.up_blocks.{i}.0')"}, in: ["x"], out: "x", name: "up{i}", when: "up == 1"},
          {repeat: "l", count: "layers[i]", body: [
            {let: {p: "fmt('decoder.up_blocks.{i}.{up + l}')"}},
            {use: "resnet", args: {p: "p", kind: "'rms'"}, in: ["x"], out: "x", name: "b{i}.{l}", when: "types[i] == 'ResBlock'"},
            {use: "evit", args: {p: "p"}, in: ["x"], out: "x", name: "b{i}.{l}", when: "types[i] == 'EfficientViTBlock'"},
          ]},
        ]},
        {use: "channel_rms_norm", args: {w: "'decoder.norm_out'"}, in: ["x"], out: "x", name: "norm_out"},
        {op: "Unary", args: {kind: "Relu"}, in: ["x"], out: "x", name: "act_out"},
        {use: "conv", args: {w: "'decoder.conv_out'"}, in: ["x"], out: "image", name: "conv_out"},
      ],
      outputs: ["image"],
    },
  },
}

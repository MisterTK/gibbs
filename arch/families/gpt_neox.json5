// GPT-NeoX (Pythia, ...): biased LayerNorms, fused per-head-interleaved query_key_value (split at
// load), partial half-split RoPE (rotary_pct, default 0.25), plain GELU MLP, parallel residual
// (default) and an untied `embed_out` head (`*ForSequenceClassification` checkpoints have none: their
// unused decode logits tie to `embed_in`; runtime::seqcls reads the `score` instance).
{
  family: "gpt_neox",
  match: {hf_model_type: ["gpt_neox"], hf_architectures: ["GPTNeoXForCausalLM", "GPTNeoXForSequenceClassification"]},
  pipeline: "causal_lm",
  use_lib: ["transformer"],
  config: {
    hidden: "cfg.hidden_size",
    layers: "cfg.num_hidden_layers",
    heads: "cfg.num_attention_heads",
    kv_heads: "heads",
    head_dim: "hidden // heads",
    vocab: "first(shape('gpt_neox.embed_in.weight')[0], cfg.vocab_size)",
    inter: "first(cfg.intermediate_size, 4 * hidden)",
    eps: "first(cfg.layer_norm_eps, 1e-5)",
    norm_kind: "'layer'",
    act: "first(cfg.hidden_act, 'gelu') == 'gelu' ? 'GeluErf' : contains(['gelu_new', 'gelu_fast', 'gelu_pytorch_tanh'], cfg.hidden_act) ? 'GeluTanh' : cfg.hidden_act == 'relu' ? 'Relu' : 'Silu'",
    theta: "first(cfg.rope_theta, cfg.rotary_emb_base, cfg.rope_parameters.rope_theta, 10000)",
    rotary_pct: "first(cfg.rotary_pct, cfg.partial_rotary_factor, 0.25)",
    rotary_dim: "int(head_dim * rotary_pct)",
    rope_variant: "'HalfSplit'",
    attn_scale: "1 / sqrt(head_dim)",
    parallel: "first(cfg.use_parallel_residual, true)",
    ctx: "first(runtime.ctx, min(first(cfg.max_position_embeddings, 2048), 4096))",
  },
  checks: [
    {expr: "rotary_dim % 2 != 0", error: "rotary dim {rotary_dim} is odd"},
    {expr: "cfg.rope_scaling != null", error: "GPT-NeoX rope_scaling is not implemented"},
  ],
  transforms: [
    // [heads, (q, k, v), head_dim] rows -> q, k, v.
    {tensor: "gpt_neox.layers.{i}.attention.query_key_value.weight", op: "deinterleave_heads", args: {heads: "heads", parts: [
      ["gpt_neox.layers.{i}.attention.query.weight", "head_dim"], ["gpt_neox.layers.{i}.attention.key.weight", "head_dim"],
      ["gpt_neox.layers.{i}.attention.value.weight", "head_dim"]]}},
    {tensor: "gpt_neox.layers.{i}.attention.query_key_value.bias", op: "deinterleave_heads", args: {heads: "heads", parts: [
      ["gpt_neox.layers.{i}.attention.query.bias", "head_dim"], ["gpt_neox.layers.{i}.attention.key.bias", "head_dim"],
      ["gpt_neox.layers.{i}.attention.value.bias", "head_dim"]]}},
  ],
  constants: {
    "rope.inv_freq": {gen: "rope_inv_freq", when: "rotary_dim > 0", args: {dim: "rotary_dim", theta: "theta", precision: "'f32'"}},
  },
  // Buffers of old checkpoints.
  ignore: ["gpt_neox.layers.*.attention.rotary_emb.inv_freq", "gpt_neox.layers.*.attention.bias", "gpt_neox.layers.*.attention.masked_bias"],
  components: {
    text: {
      vars: ["rows", "head"],
      inputs: [
        {name: "token_ids", dtype: "u32", shape: ["rows"]},
        {name: "positions", dtype: "u32", shape: ["rows"]},
        {name: "last_index", dtype: "u32", shape: [1], when: "head == 'score'"},
      ],
      body: [
        {op: "Embedding", in: ["w:gpt_neox.embed_in.weight", "i:token_ids"], out: "x", name: "embed"},
        {repeat: "i", count: "layers", body: [
          {let: {p: "fmt('gpt_neox.layers.{i}')"}},
          {use: "layer_norm", args: {w: "fmt('{p}.input_layernorm')"}, in: ["x"], out: "h", name: "l{i}.ln1"},
          {use: "attn_cached", in: ["h"], out: "a", name: "l{i}.attn", args: {
            layer: "i", wq: "fmt('{p}.attention.query')", wk: "fmt('{p}.attention.key')",
            wv: "fmt('{p}.attention.value')", wo: "fmt('{p}.attention.dense')"}},
          {block: [
            {use: "layer_norm", args: {w: "fmt('{p}.post_attention_layernorm')"}, in: ["x"], out: "h", name: "l{i}.ln2"},
            {use: "mlp_plain", in: ["h"], out: "m", name: "l{i}.mlp", args: {up: "fmt('{p}.mlp.dense_h_to_4h')", down: "fmt('{p}.mlp.dense_4h_to_h')"}},
            {use: "parallel_residual", in: ["x", "a", "m"], out: "x", name: "l{i}.res"},
          ], when: "parallel"},
          {block: [
            {use: "residual", in: ["x", "a"], out: "x", name: "l{i}.res1"},
            {use: "layer_norm", args: {w: "fmt('{p}.post_attention_layernorm')"}, in: ["x"], out: "h", name: "l{i}.ln2"},
            {use: "mlp_plain", in: ["h"], out: "m", name: "l{i}.mlp", args: {up: "fmt('{p}.mlp.dense_h_to_4h')", down: "fmt('{p}.mlp.dense_4h_to_h')"}},
            {use: "residual", in: ["x", "m"], out: "x", name: "l{i}.res2"},
          ], when: "!parallel"},
          {tap: "layer.{i}", in: "x"},
        ]},
        {use: "last_row", in: ["x"], out: "x", name: "last", when: "head == 'last'"},
        {use: "last_row", args: {index: true}, in: ["x", "i:last_index"], out: "x", name: "last", when: "head == 'score'"},
        {use: "layer_norm", args: {w: "'gpt_neox.final_layer_norm'"}, in: ["x"], out: "hidden", name: "final_norm"},
        {use: "score_head", in: ["hidden"], out: "logits", name: "score", when: "head == 'score'"},
        {use: "lm_head", args: {w: "has('embed_out.weight') ? 'embed_out' : 'gpt_neox.embed_in'"}, in: ["hidden"], out: "logits", name: "lm_head", when: "head == 'last' || head == 'all'"},
      ],
      outputs: [{name: "logits", when: "head != 'hidden'"}, {name: "hidden", when: "head == 'hidden'"}],
    },
  },
  runtime: {ffn_weights: ["gpt_neox.layers.*.mlp.*"], seqcls: {head: "score", pooling: "last_nonpad"}},
}

// The SD / SDXL UNet of an LDM single-file / GGUF checkpoint (`model.diffusion_model.*` via the
// `ldm` names, layers_per_block 2) under its reference repo's `unet/config.json`; the other
// components' tensors and the training buffers are ignored.
{
  family: "ldm_unet",
  extends: "sd",
  ignore: ["first_stage_model.*", "cond_stage_model.*", "conditioner.*", "model_ema.*",
           "alphas_cumprod*", "betas", "log_one_minus_alphas_cumprod", "posterior_*", "sqrt_*", "logvar", "denoiser.*"],
}

// The AutoencoderKL of an LDM single-file / GGUF checkpoint (`first_stage_model.*` via `ldm_vae`)
// under its reference repo's `vae/config.json`; the other components' tensors are ignored.
{
  family: "ldm_vae",
  extends: "sd_vae",
  ignore: ["model.diffusion_model.*", "cond_stage_model.*", "conditioner.*", "model_ema.*",
           "alphas_cumprod*", "betas", "log_one_minus_alphas_cumprod", "posterior_*", "sqrt_*", "logvar", "denoiser.*"],
}

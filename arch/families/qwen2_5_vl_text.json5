// The text decoder of a Qwen2.5-VL checkpoint (transformers `qwen2_5_vl`), as a text encoder (Qwen-
// Image 1): the qwen2 llama-style decoder under `model.language_model.*` (newer transformers) or
// `model.*`; the vision tower and LM head are not read. Text-only prompts put every M-RoPE axis at
// the sequence index, so they rotate as plain half-split RoPE. Referenced by `{family, dir}`.
{
  family: "qwen2_5_vl_text",
  extends: "llama",
  names: {rules: [["model.language_model.{r:*}", "model.{r}"]]},
  config: {
    tc: "first(cfg.text_config, cfg)",
    hidden: "tc.hidden_size",
    layers: "tc.num_hidden_layers",
    heads: "tc.num_attention_heads",
    kv_heads: "first(tc.num_key_value_heads, heads)",
    head_dim: "first(tc.head_dim, hidden // heads)",
    inter: "tc.intermediate_size",
    eps: "first(tc.rms_norm_eps, 1e-6)",
    theta: "first(tc.rope_theta, 1000000)",
    rotary_pct: "1",
    rope_variant: "'HalfSplit'",
    rope_kind: "'default'",
    ctx: "first(runtime.ctx, 4096)",
  },
  // Matrices run in bf16 (F32 checkpoints are rounded, as the reference encoder reads them).
  transforms: [
    {tensor: "{n:*}.weight", op: "to_bf16", when: "len(shape(fmt('{n}.weight'))) == 2"},
  ],
  ignore: ["visual.*", "model.visual.*", "lm_head.weight"],
}

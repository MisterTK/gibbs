// Qwen4-Exp (transformers `qwen4_exp`, llama.cpp `qwen4exp`): the Qwen3.5(-MoE) decoder with three
// additions. Hyper-connections: `hc_count` residual streams ([rows, hc_count * hidden]); before
// each token mixer and each FFN a low-rank gate (`hc_mix`) collapses them to one normed input, and
// the block output is added back to every stream with its own weight (`hc_combine`); a final mixer
// replaces `model.norm`. QSA: attention layers read, per query, the `budget / ratio` best blocks of
// `ratio` keys (scored by a pooled-key indexer) plus the incomplete tail. PLE: one linear-attention
// layer adds a hashed n-gram embedding (host hash `ngram_hash_rows`) gated into every stream.
// Reference: transformers `models/qwen4_exp/modeling_qwen4_exp.py`, llama.cpp `src/models/qwen4exp.cpp`.
{
  family: "qwen4_exp",
  extends: "qwen3_5",
  match: {hf_model_type: ["qwen4_exp", "qwen4_exp_text"], hf_architectures: ["Qwen4ExpForCausalLM"], gguf_arch: ["qwen4exp"]},
  config: {
    attn_gate: "true",
    sigmoid_gate: "first(tc.output_gate_type, gguf_arch == 'qwen4exp' ? 'sigmoid' : 'silu') == 'sigmoid'",
    hc_count: "first(tc.hc_count, gguf['hyper_connection.count'])",
    hc_lowrank: "first(tc.hc_lowrank, gguf['hyper_connection.low_rank'])",
    indexer_heads: "first(tc.indexer_n_heads, gguf['attention.indexer.head_count'])",
    indexer_dim: "first(tc.indexer_head_dim, gguf['attention.indexer.key_length'])",
    indexer_kv_heads: "first(tc.indexer_kv_heads, 1)",
    // llama.cpp lists a ratio per layer (0 on linear-attention layers).
    indexer_ratio: "first(tc.indexer_compress_ratio, max(gguf['attention.compress_ratios']))",
    indexer_budget: "first(tc.indexer_budget, gguf['attention.indexer.top_k'])",
    indexer_top: "indexer_budget // indexer_ratio",
    // PLE layer, 0-based (transformers' `ple_layer_ids` are 1-based); -1: none.
    ple_layer: "tc.ple_layer_ids != null ? at(tc.ple_layer_ids, 0) - 1 : gguf['ple.layers'] != null ? first(at(gguf['ple.layers'], 0), gguf['ple.layers']) : -1",
    ple_ngram: "first(tc.ngram_size, gguf['ple.ngram_size'])",
    ple_per_gram: "first(tc.heads_per_ngram, gguf['ple.heads_per_ngram'])",
    ple_heads: "(ple_ngram - 1) * ple_per_gram",
    ple_kernel: "first(tc.ple_conv_kernel_size, gguf['ple.conv_kernel'])",
    ple_eos: "first(gguf['ple.eos_token_id'], at(tc.eos_token_id, 0), tc.eos_token_id)",
    ple_mult: "first(tc.ple_hash.multipliers, gguf['ple.layer_multipliers'])",
    ple_offsets: "first(tc.ple_hash.offsets, gguf['ple.head_offsets'])",
    ple_vocab: "first(tc.ple_hash.vocab_sizes, gguf['ple.head_vocab_sizes'])",
    // transformers stores the n-gram table per layer, llama.cpp as one global tensor.
    ple_table: "first_has(fmt('model.layers.{ple_layer}.ple.ple_embedding.table'), 'per_layer_token_embd.weight')",
  },
  // `k+` appends to qwen3_5's list (src/arch/mod.rs merge_patch); `names.use` is inherited.
  "checks+": [
    {expr: "gguf_arch == 'qwen4exp' && !has('model.layers.0.attn_hyper_connection.hc_norm.weight')",
     error: "this qwen4exp file is a detached MTP head (no trunk tensors); load the trunk GGUF"},
    {expr: "indexer_kv_heads != 1", error: "QSA indexers with several key heads are not implemented"},
    {expr: "indexer_ratio < 2 || indexer_budget < indexer_ratio || indexer_budget % indexer_ratio != 0",
     error: "QSA needs a compress ratio above 1 that divides the budget, got {indexer_ratio} and {indexer_budget}"},
    {expr: "ple_layer >= 0 && has(fmt('model.layers.{ple_layer}.self_attn.q_proj.weight'))",
     error: "layer {ple_layer}: PLE on an attention layer is not implemented"},
    {expr: "ple_layer >= 0 && ple_mult == null",
     error: "PLE hash constants stored as checkpoint buffers (`ple_embedding.layer_multipliers`) are not read; config `ple_hash` or GGUF metadata must carry them"},
    // ponytail: spec values are f64; read the constants as integers if a checkpoint needs bigger ones.
    {expr: "ple_layer >= 0 && max(ple_mult) >= 2 ** 53", error: "PLE hash multipliers above 2^53 are not representable"},
  ],
  names: {
    rules: [
      ["output_hc_norm.weight", "model.hyper_connection_mixer.hc_norm.weight"],
      ["output_hc_{n:*}.weight", "model.hyper_connection_mixer.input_mix_weight_{n}.weight"],
      ["blk.{i}.hc_attn_norm.weight", "model.layers.{i}.attn_hyper_connection.hc_norm.weight"],
      ["blk.{i}.hc_attn_inject.weight", "model.layers.{i}.attn_hyper_connection.block_inject_weight.weight"],
      ["blk.{i}.hc_attn_{n:*}.weight", "model.layers.{i}.attn_hyper_connection.input_mix_weight_{n}.weight"],
      ["blk.{i}.hc_ffn_norm.weight", "model.layers.{i}.mlp_hyper_connection.hc_norm.weight"],
      ["blk.{i}.hc_ffn_inject.weight", "model.layers.{i}.mlp_hyper_connection.block_inject_weight.weight"],
      ["blk.{i}.hc_ffn_{n:*}.weight", "model.layers.{i}.mlp_hyper_connection.input_mix_weight_{n}.weight"],
      ["blk.{i}.indexer.{n:*}_proj.weight", "model.layers.{i}.self_attn.indexer.index_{n}_proj.weight"],
      ["blk.{i}.indexer.{n:*}_norm.weight", "model.layers.{i}.self_attn.indexer.{n}_layernorm.weight"],
      ["blk.{i}.ple_key.weight", "model.layers.{i}.ple.key_proj.weight"],
      ["blk.{i}.ple_value.weight", "model.layers.{i}.ple.value_proj.weight"],
      ["blk.{i}.ple_norm_{n:*}.weight", "model.layers.{i}.ple.norm_{n}.weight"],
      ["blk.{i}.ple_conv1d.weight", "model.layers.{i}.ple.conv1d.weight"],
    ],
  },
  "transforms+": [
    // Qwen4-Exp `1 + w` gains (the indexer's `*_layernorm` take qwen3_5's layernorm rule).
    {tensor: "model.{s:*}hc_norm.weight", op: "add", args: {value: 1}, when: "norm_offset"},
    {tensor: "model.layers.{i}.ple.norm_{n:*}.weight", op: "add", args: {value: 1}, when: "norm_offset"},
    {tensor: "model.layers.{i}.self_attn.indexer.index_qk_proj.weight", op: "split_rows", args: {parts: [
      ["model.layers.{i}.self_attn.indexer.index_q_proj.weight", "indexer_heads * indexer_dim"],
      ["model.layers.{i}.self_attn.indexer.index_k_proj.weight", "indexer_dim"]]}},
    // n-gram table: transformers `[parts, rows, dim]` (or one tensor per part) -> `[parts * rows, dim]`.
    {tensor: "model.layers.{i}.ple.ple_embedding.ngram_embedding.shard_{e}.weight", op: "stack_experts",
     args: {out: "model.layers.{i}.ple.ple_embedding.table"}},
    {tensor: "model.layers.{i}.ple.ple_embedding.table", op: "reshape",
     when: "len(shape(fmt('model.layers.{i}.ple.ple_embedding.table'))) == 3",
     args: {shape: ["at(shape(fmt('model.layers.{i}.ple.ple_embedding.table')), 0) * at(shape(fmt('model.layers.{i}.ple.ple_embedding.table')), 1)",
                    "at(shape(fmt('model.layers.{i}.ple.ple_embedding.table')), 2)"]}},
    {tensor: "model.layers.{i}.ple.conv1d.weight", op: "reshape", args: {shape: ["hc_count * hidden", "ple_kernel"]}},
    {tensor: "model.layers.{i}.ple.conv1d.weight", op: "to_f32"},
  ],
  constants: {
    "hc.ones": {gen: "ones", args: {shape: ["hidden"]}},
  },
  macros: {
    // RMSNorm of each `hidden` stream of `x` [rows, hc_count * hidden] with its own gains `{w}.weight`.
    hc_norm: {params: ["x"], body: [
      {let: {nr: "shape('x')[0]"}},
      {op: "Reshape", args: {shape: ["nr * hc_count", "hidden"]}, in: ["x"], out: "y", name: "streams"},
      {op: "RmsNorm", args: {eps: "eps"}, in: ["y", "c:hc.ones"], out: "y", name: "rms"},
      {op: "Reshape", args: {shape: ["nr", "hc_count * hidden"]}, in: ["y"], out: "y", name: "rows"},
      {op: "Binary", args: {kind: "'Mul'"}, in: ["y", "w:{w}.weight"], out: "out", name: "gain"},
    ]},
    // Hyper-connection mixer `p`: the normed streams' sigmoid gate (low-rank SiLU down/up) averages
    // them into one row [rows, hidden]; `inject`: also the per-stream block weights `inj` [rows, hc_count].
    hc_mix: {params: ["x"], returns: ["out", "inj"], body: [
      {let: {nr: "shape('x')[0]"}},
      {use: "hc_norm", args: {w: "fmt('{p}.hc_norm')"}, in: ["x"], out: "n", name: "norm"},
      {op: "Linear", in: ["n", "w:{p}.input_mix_weight_down.weight"], out: "g", name: "down"},
      {op: "Unary", args: {kind: {Scale: "1 / hc_count"}}, in: ["g"], out: "g", name: "down_scale"},
      {op: "Unary", args: {kind: "'Silu'"}, in: ["g"], out: "g", name: "silu"},
      {op: "Linear", in: ["g", "w:{p}.input_mix_weight_up.weight"], out: "g", name: "up"},
      {op: "Unary", args: {kind: "'Sigmoid'"}, in: ["g"], out: "g", name: "gate"},
      {op: "Binary", args: {kind: "'Mul'"}, in: ["g", "n"], out: "m", name: "gated"},
      {op: "Reshape", args: {shape: ["nr", "hc_count", "hidden"]}, in: ["m"], out: "m", name: "split"},
      {op: "Reduce", args: {kind: "'Sum'", axes: [1], keep_dims: false}, in: ["m"], out: "out", name: "sum"},
      {op: "Unary", args: {kind: {Scale: "1 / hc_count"}}, in: ["out"], out: "out", name: "mean"},
      {block: [
        {op: "Linear", in: ["n", "w:{p}.block_inject_weight.weight"], out: "inj", name: "inject"},
        {op: "Unary", args: {kind: {Scale: "1 / hc_count"}}, in: ["inj"], out: "inj", name: "inject_scale"},
        {op: "Unary", args: {kind: "'Sigmoid'"}, in: ["inj"], out: "inj", name: "inject_sigmoid"},
        {op: "Unary", args: {kind: {Scale: 2}}, in: ["inj"], out: "inj", name: "inject_double"},
      ], when: "inject"},
    ]},
    // Streams `x` [rows, hc_count * hidden] + block output `y` [rows, hidden] weighted per stream by `inj`.
    hc_combine: {params: ["x", "y", "inj"], body: [
      {let: {nr: "shape('x')[0]"}},
      {op: "Reshape", args: {shape: ["nr", 1, "hidden"]}, in: ["y"], out: "y", name: "y_row"},
      {op: "Reshape", args: {shape: ["nr", "hc_count", 1]}, in: ["inj"], out: "w", name: "w_col"},
      {op: "Binary", args: {kind: "'Mul'"}, in: ["y", "w"], out: "d", name: "weighted"},
      {op: "Reshape", args: {shape: ["nr", "hc_count * hidden"]}, in: ["d"], out: "d", name: "rows"},
      {op: "Binary", args: {kind: "'Add'"}, in: ["x", "d"], out: "out", name: "add"},
    ]},
    // PLE `p` (stem `model.layers.{i}.ple`) on streams `x`: the hashed n-gram rows `ple_rows` give a
    // key per stream and a shared value; sigmoid(signed sqrt(key . normed stream / sqrt(hidden)))
    // gates the value per stream, plus SiLU of a depthwise conv dilated by `ple_ngram` over the
    // normed gated value (recurrent ring `ple.{layer}`).
    ple: {params: ["x"], body: [
      {let: {nr: "shape('x')[0]"}},
      {op: "Embedding", in: ["w:{ple_table}", "i:ple_rows"], out: "e", name: "table"},
      {op: "Reshape", args: {shape: ["nr", "ple_heads * shape('e')[1]"]}, in: ["e"], out: "e", name: "rows"},
      {op: "Linear", in: ["e", "w:{p}.key_proj.weight"], out: "k", name: "key"},
      {op: "Linear", in: ["e", "w:{p}.value_proj.weight"], out: "v", name: "value"},
      {use: "hc_norm", args: {w: "fmt('{p}.norm_key')"}, in: ["k"], out: "k", name: "norm_key"},
      {use: "hc_norm", args: {w: "fmt('{p}.norm_query')"}, in: ["x"], out: "q", name: "norm_query"},
      {op: "Binary", args: {kind: "'Mul'"}, in: ["k", "q"], out: "s", name: "kq"},
      {op: "Reshape", args: {shape: ["nr", "hc_count", "hidden"]}, in: ["s"], out: "s", name: "kq_streams"},
      {op: "Reduce", args: {kind: "'Sum'", axes: [2], keep_dims: true}, in: ["s"], out: "s", name: "dot"},
      {op: "Unary", args: {kind: {Scale: "1 / sqrt(hidden)"}}, in: ["s"], out: "s", name: "dot_scale"},
      {op: "Unary", args: {kind: "'Sign'"}, in: ["s"], out: "sg", name: "sign"},
      {op: "Unary", args: {kind: "'Abs'"}, in: ["s"], out: "m", name: "abs"},
      {op: "Unary", args: {kind: {Clamp: [1e-6, 3.0e38]}}, in: ["m"], out: "m", name: "floor"},
      {op: "Unary", args: {kind: "'Sqrt'"}, in: ["m"], out: "m", name: "sqrt"},
      {op: "Binary", args: {kind: "'Mul'"}, in: ["sg", "m"], out: "s", name: "signed_sqrt"},
      {op: "Unary", args: {kind: "'Sigmoid'"}, in: ["s"], out: "s", name: "gate"},
      {op: "Reshape", args: {shape: ["nr", 1, "hidden"]}, in: ["v"], out: "v", name: "value_row"},
      {op: "Binary", args: {kind: "'Mul'"}, in: ["s", "v"], out: "gv", name: "gated"},
      {op: "Reshape", args: {shape: ["nr", "hc_count * hidden"]}, in: ["gv"], out: "gv", name: "gated_rows"},
      {use: "hc_norm", args: {w: "fmt('{p}.norm_conv')"}, in: ["gv"], out: "c", name: "norm_conv"},
      {state: "ple.{layer}", shape: ["(ple_kernel - 1) * ple_ngram", "hc_count * hidden"], recurrent: true},
      {op: "CausalConv1dCached", args: {kernel: "ple_kernel", dilation: "ple_ngram"},
       in: ["c", "w:{p}.conv1d.weight", "s:ple.{layer}"], out: "c", name: "conv"},
      {op: "Unary", args: {kind: "'Silu'"}, in: ["c"], out: "c", name: "conv_silu"},
      {op: "Binary", args: {kind: "'Add'"}, in: ["gv", "c"], out: "o", name: "sum"},
      {op: "Binary", args: {kind: "'Add'"}, in: ["x", "o"], out: "out", name: "add"},
    ]},
    // QSA attention `p` (stem `...self_attn`) over `kv.{layer}.{k,v}`: `qwen_attn`'s gated q/k/v
    // chain; the keys/values go to the cache with `StateWrite`, the indexer's raw keys to
    // `qsa.{layer}`. Scores per (row, complete block): sum over indexer heads of relu(q . pooled
    // key) / sqrt(indexer_dim), the pooled key being the block's mean raw key, normed and rotated
    // to the block start. `QsaSelect` / `QsaBias` pick each row's keys; attention over the gathered
    // keys runs as batched MatMuls ([rows, kv_heads, group, K]).
    // ponytail: pooled keys are recomputed over the whole cache every pass; keep them in a state
    // when long contexts make that matter.
    qsa_attn: {params: ["x"], body: [
      {let: {nr: "shape('x')[0]", nk: "indexer_top * indexer_ratio + indexer_ratio - 1",
             nb: "ctx // indexer_ratio", grp: "heads // kv_heads"}},
      {op: "Linear", in: ["x", "w:{p}.q_proj.weight", "w?:{p}.q_proj.bias"], out: "qg", name: "q"},
      {op: "Reshape", args: {shape: ["nr * heads", "2 * head_dim"]}, in: ["qg"], out: "qg", name: "q_heads"},
      {op: "Slice", args: {axis: -1, start: 0, end: "head_dim"}, in: ["qg"], out: "q", name: "q_slice"},
      {op: "Slice", args: {axis: -1, start: "head_dim", end: "2 * head_dim"}, in: ["qg"], out: "g", name: "gate_slice"},
      {op: "Linear", in: ["x", "w:{p}.k_proj.weight", "w?:{p}.k_proj.bias"], out: "k", name: "k"},
      {op: "Linear", in: ["x", "w:{p}.v_proj.weight", "w?:{p}.v_proj.bias"], out: "v", name: "v"},
      {op: "RmsNorm", args: {eps: "eps"}, in: ["q", "w:{p}.q_norm.weight"], out: "q", name: "q_norm"},
      {op: "RmsNorm", args: {eps: "eps"}, in: ["k", "w:{p}.k_norm.weight"], out: "k", name: "k_norm"},
      {op: "Reshape", args: {shape: ["nr", "heads * head_dim"]}, in: ["q"], out: "q", name: "q_rows"},
      {op: "Rope", args: {head_dim: "head_dim", rotary_dim: "rotary_dim", variant: "'HalfSplit'", mscale: 1},
       in: ["q", "i:positions", "c:rope.inv_freq"], out: "q", name: "q_rope"},
      {op: "Rope", args: {head_dim: "head_dim", rotary_dim: "rotary_dim", variant: "'HalfSplit'", mscale: 1},
       in: ["k", "i:positions", "c:rope.inv_freq"], out: "k", name: "k_rope"},
      {state: "kv.{layer}.k", shape: ["ctx", "kv_heads * head_dim"]},
      {state: "kv.{layer}.v", shape: ["ctx", "kv_heads * head_dim"]},
      {op: "StateWrite", in: ["s:kv.{layer}.k", "k", "i:pos0"], out: "wk", name: "k_write"},
      {op: "StateWrite", in: ["s:kv.{layer}.v", "v", "i:pos0"], out: "wv", name: "v_write"},
      // Indexer.
      {op: "Linear", in: ["x", "w:{p}.indexer.index_q_proj.weight"], out: "iq", name: "index_q"},
      {op: "Linear", in: ["x", "w:{p}.indexer.index_k_proj.weight"], out: "ik", name: "index_k"},
      {op: "RmsNorm", args: {eps: "eps"}, in: ["iq", "w:{p}.indexer.q_layernorm.weight"], out: "iq", name: "index_q_norm"},
      {op: "Rope", args: {head_dim: "indexer_dim", rotary_dim: "rotary_dim", variant: "'HalfSplit'", mscale: 1},
       in: ["iq", "i:positions", "c:rope.inv_freq"], out: "iq", name: "index_q_rope"},
      {state: "qsa.{layer}", shape: ["ctx", "indexer_dim"]},
      {op: "StateWrite", in: ["s:qsa.{layer}", "ik", "i:pos0"], out: "wi", name: "index_k_write"},
      {op: "Slice", args: {axis: 0, start: 0, end: "nb * indexer_ratio"}, in: ["s:qsa.{layer}"], out: "pk", name: "index_keys"},
      {op: "Reshape", args: {shape: ["nb", "indexer_ratio", "indexer_dim"]}, in: ["pk"], out: "pk", name: "index_blocks"},
      {op: "Reduce", args: {kind: "'Mean'", axes: [1], keep_dims: false}, in: ["pk"], out: "pk", name: "index_pool"},
      {op: "RmsNorm", args: {eps: "eps"}, in: ["pk", "w:{p}.indexer.k_layernorm.weight"], out: "pk", name: "index_k_norm"},
      {op: "Rope", args: {head_dim: "indexer_dim", rotary_dim: "rotary_dim", variant: "'HalfSplit'", mscale: 1},
       in: ["pk", "i:qsa_block_pos", "c:rope.inv_freq"], out: "pk", name: "index_k_rope"},
      {op: "Reshape", args: {shape: ["nr * indexer_heads", "indexer_dim"]}, in: ["iq"], out: "iq", name: "index_q_heads"},
      {op: "MatMul", args: {transpose_a: false, transpose_b: true}, in: ["iq", "pk"], out: "sc", name: "index_dot"},
      {op: "Unary", args: {kind: "'Relu'"}, in: ["sc"], out: "sc", name: "index_relu"},
      {op: "Reshape", args: {shape: ["nr", "indexer_heads", "nb"]}, in: ["sc"], out: "sc", name: "index_head_scores"},
      {op: "Reduce", args: {kind: "'Sum'", axes: [1], keep_dims: false}, in: ["sc"], out: "sc", name: "index_sum"},
      {op: "Unary", args: {kind: {Scale: "1 / sqrt(indexer_dim)"}}, in: ["sc"], out: "sc", name: "index_scale"},
      {op: "QsaSelect", args: {ratio: "indexer_ratio", top_blocks: "indexer_top"}, in: ["sc", "i:positions"], out: "ids", name: "select"},
      {op: "QsaBias", args: {ratio: "indexer_ratio", top_blocks: "indexer_top"}, in: ["sc", "i:positions"], out: "bias", name: "select_bias"},
      // Attention over each row's gathered keys.
      {op: "Gather", args: {axis: 0}, in: ["s:kv.{layer}.k", "ids"], out: "kg", name: "k_gather"},
      {op: "Gather", args: {axis: 0}, in: ["s:kv.{layer}.v", "ids"], out: "vg", name: "v_gather"},
      {op: "Reshape", args: {shape: ["nr", "nk", "kv_heads", "head_dim"]}, in: ["kg"], out: "kg", name: "k_heads"},
      {op: "Transpose", args: {perm: [0, 2, 1, 3]}, in: ["kg"], out: "kg", name: "k_by_head"},
      {op: "Reshape", args: {shape: ["nr", "nk", "kv_heads", "head_dim"]}, in: ["vg"], out: "vg", name: "v_heads"},
      {op: "Transpose", args: {perm: [0, 2, 1, 3]}, in: ["vg"], out: "vg", name: "v_by_head"},
      {op: "Reshape", args: {shape: ["nr", "kv_heads", "grp", "head_dim"]}, in: ["q"], out: "q", name: "q_groups"},
      {op: "MatMul", args: {transpose_a: false, transpose_b: true}, in: ["q", "kg"], out: "s", name: "scores"},
      {op: "Unary", args: {kind: {Scale: "1 / sqrt(head_dim)"}}, in: ["s"], out: "s", name: "score_scale"},
      {op: "Reshape", args: {shape: ["nr", 1, 1, "nk"]}, in: ["bias"], out: "bias", name: "bias_rows"},
      {op: "Binary", args: {kind: "'Add'"}, in: ["s", "bias"], out: "s", name: "masked"},
      {op: "Softmax", args: {axis: -1}, in: ["s"], out: "s", name: "softmax"},
      {op: "MatMul", args: {transpose_a: false, transpose_b: false}, in: ["s", "vg"], out: "a", name: "weighted"},
      {op: "Reshape", args: {shape: ["nr", "heads * head_dim"]}, in: ["a"], out: "a", name: "a_rows"},
      {op: "Reshape", args: {shape: ["nr", "heads * head_dim"]}, in: ["g"], out: "g", name: "gate_rows"},
      {op: "Unary", args: {kind: "'Sigmoid'"}, in: ["g"], out: "g", name: "gate_act"},
      {op: "Binary", args: {kind: "'Mul'"}, in: ["a", "g"], out: "a", name: "gated_core"},
      {op: "Linear", in: ["a", "w:{p}.o_proj.weight", "w?:{p}.o_proj.bias"], out: "out", name: "o"},
    ]},
  },
  components: {
    text: {
      vars: ["rows", "head"],
      inputs: [
        {name: "token_ids", dtype: "u32", shape: ["rows"]},
        {name: "positions", dtype: "u32", shape: ["rows"]},
        {name: "pos0", dtype: "u32", shape: [1], gen: "iota", args: {n: 1, start: "pos0"}},
        {name: "qsa_block_pos", dtype: "u32", shape: ["ctx // indexer_ratio"], gen: "iota",
         args: {n: "ctx // indexer_ratio", step: "indexer_ratio"}},
        {name: "ple_rows", dtype: "u32", shape: ["rows * ple_heads"], gen: "ngram_hash_rows", when: "ple_layer >= 0",
         args: {ids: "ids", back: "ple_ngram - 1", rows: "rows", ngram: "ple_ngram", per_gram: "ple_per_gram",
                multipliers: "ple_mult", offsets: "ple_offsets", vocab_sizes: "ple_vocab", eos: "ple_eos"}},
      ],
      body: [
        {op: "Embedding", in: ["w:model.embed_tokens.weight", "i:token_ids"], out: "x", name: "embed"},
        {op: "Tile", args: {reps: [1, "hc_count"]}, in: ["x"], out: "x", name: "streams"},
        {repeat: "i", count: "layers", body: [
          {let: {p: "fmt('model.layers.{i}')"}},
          {use: "ple", in: ["x"], out: "x", name: "layers.{i}.ple", when: "i == ple_layer", args: {p: "fmt('{p}.ple')", layer: "i"}},
          {use: "hc_mix", in: ["x"], out: ["h", "inj"], name: "layers.{i}.attn_hc",
           args: {p: "fmt('{p}.attn_hyper_connection')", inject: true}},
          {use: "gated_deltanet", in: ["h"], out: "a", name: "layers.{i}.mixer", when: "has(fmt('{p}.linear_attn.in_proj_qkv.weight'))",
           args: {p: "fmt('{p}.linear_attn')", layer: "i", tiled: "out_tiled", sigmoid_gate: "sigmoid_gate"}},
          {use: "qsa_attn", in: ["h"], out: "a", name: "layers.{i}.self_attn", when: "!has(fmt('{p}.linear_attn.in_proj_qkv.weight'))",
           args: {p: "fmt('{p}.self_attn')", layer: "i"}},
          {use: "hc_combine", in: ["x", "a", "inj"], out: "x", name: "layers.{i}.add_mixer"},
          {use: "hc_mix", in: ["x"], out: ["h", "inj"], name: "layers.{i}.mlp_hc",
           args: {p: "fmt('{p}.mlp_hyper_connection')", inject: true}},
          {use: "mlp_glu", in: ["h"], out: "m", name: "layers.{i}.mlp", when: "experts == 0",
           args: {gate: "fmt('{p}.mlp.gate_proj')", up: "fmt('{p}.mlp.up_proj')", down: "fmt('{p}.mlp.down_proj')"}},
          {use: "moe_shared", in: ["h"], out: "m", name: "layers.{i}.mlp", when: "experts > 0", args: {p: "fmt('{p}.mlp')"}},
          {use: "hc_combine", in: ["x", "m", "inj"], out: "x", name: "layers.{i}.add_ffn"},
          {tap: "layer.{i}", in: "x"},
        ]},
        {use: "last_row", in: ["x"], out: "x", name: "last", when: "head == 'last'"},
        {use: "hc_mix", in: ["x"], out: "hidden", name: "final_mixer", args: {p: "'model.hyper_connection_mixer'", inject: false}},
        {use: "lm_head", args: {w: "head_w"}, in: ["hidden"], out: "logits", name: "lm_head", when: "head != 'hidden'"},
      ],
      outputs: [{name: "logits", when: "head != 'hidden'"}, {name: "hidden", when: "head == 'hidden'"}],
    },
  },
}

// OpenCLIP-G text tower of an SDXL LDM single-file checkpoint (`conditioner.embedders.1.model.*`,
// OpenCLIP naming, all blocks); the rest of the file is ignored.
{
  family: "sdxl_clip_g",
  extends: "clip_text",
  use_lib: ["transformer", "ldm"],
  names: {strip: ["conditioner.embedders.1.model."]},
  "ignore+": ["conditioner.embedders.0.*", "model.diffusion_model.*", "first_stage_model.*", "denoiser.*"],
}

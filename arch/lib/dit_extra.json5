// DiT building blocks shared by the single/double-stream image transformers, and the Wan-style
// (Qwen-Image) VAE decoder blocks on channel-first [c, h, w] values. Constants a DiT family must
// declare: `one` ([1] = 1), `ones.dim` ([dim] = 1).
{
  macros: {
    // LayerNorm(x) (affine-free, `eps`) * (1 + scale) + shift; scale/shift [1, dim].
    ln_mod: {params: ["x", "shift", "scale"], body: [
      {op: "LayerNorm", args: {eps: "eps"}, in: ["x", "c:ones.dim"], out: "h", name: "ln"},
      {op: "Binary", args: {kind: "Add"}, in: ["scale", "c:one"], out: "s", name: "1p"},
      {op: "Binary", args: {kind: "Mul"}, in: ["h", "s"], out: "h", name: "mul"},
      {op: "Binary", args: {kind: "Add"}, in: ["h", "shift"], out: "out", name: "shift"},
    ]},
    // x * (1 + scale) + shift.
    modulate: {params: ["x", "shift", "scale"], body: [
      {op: "Binary", args: {kind: "Add"}, in: ["scale", "c:one"], out: "s", name: "1p"},
      {op: "Binary", args: {kind: "Mul"}, in: ["x", "s"], out: "x", name: "mul"},
      {op: "Binary", args: {kind: "Add"}, in: ["x", "shift"], out: "out", name: "shift"},
    ]},
    // x + y * gate.
    gated_add: {params: ["x", "y", "gate"], body: [
      {op: "Binary", args: {kind: "Mul"}, in: ["y", "gate"], out: "y", name: "gate"},
      {op: "Binary", args: {kind: "Add"}, in: ["x", "y"], out: "out", name: "add"},
    ]},
    // Chunk `i` ([1, dim]) of a modulation row `m` [1, k*dim].
    chunk: {params: ["m"], body: [
      {op: "Slice", args: {axis: 1, start: "i * dim", end: "(i + 1) * dim"}, in: ["m"], out: "out", name: "c{i}"},
    ]},

    // Channel RMS norm of `x` [c, h, w] with gain `{g}`: x / ||x||_c * sqrt(c) * g per pixel
    // (RmsNorm over channels moved last).
    rms_channels: {params: ["x"], body: [
      {let: {c: "shape('x')[0]", hh: "shape('x')[1]", ww: "shape('x')[2]"}},
      {op: "Reshape", args: {shape: ["c", "hh * ww"]}, in: ["x"], out: "t", name: "flat"},
      {op: "Transpose", args: {perm: [1, 0]}, in: ["t"], out: "t", name: "t"},
      {op: "RmsNorm", args: {eps: 1e-12}, in: ["t", "w:{g}"], out: "t", name: "rms"},
      {op: "Transpose", args: {perm: [1, 0]}, in: ["t"], out: "t", name: "tb"},
      {op: "Reshape", args: {shape: ["c", "hh", "ww"]}, in: ["t"], out: "out", name: "unflat"},
    ]},
    // Same-size convolution `{p}` (kernel [o, i, k, k], bias `{p}.bias`).
    vae_conv: {params: ["x"], body: [
      {let: {pad: "shape(fmt('{p}.weight'))[3] // 2"}},
      {op: "Conv2d", args: {stride: [1, 1], padding: ["pad", "pad", "pad", "pad"], dilation: [1, 1], groups: 1},
       in: ["x", "w:{p}.weight", "w?:{p}.bias"], out: "out", name: "conv"},
    ]},
    // Residual block `{p}`: conv2(silu(rms(conv1(silu(rms(x)))))) + (conv_shortcut(x) | x).
    vae_res: {params: ["x"], body: [
      {use: "vae_conv", args: {p: "fmt('{p}.conv_shortcut')"}, in: ["x"], out: "skip", name: "shortcut", when: "has(fmt('{p}.conv_shortcut.weight'))"},
      {use: "rms_channels", args: {g: "fmt('{p}.norm1.gamma')"}, in: ["x"], out: "y", name: "norm1"},
      {op: "Unary", args: {kind: "Silu"}, in: ["y"], out: "y", name: "silu1"},
      {use: "vae_conv", args: {p: "fmt('{p}.conv1')"}, in: ["y"], out: "y", name: "conv1"},
      {use: "rms_channels", args: {g: "fmt('{p}.norm2.gamma')"}, in: ["y"], out: "y", name: "norm2"},
      {op: "Unary", args: {kind: "Silu"}, in: ["y"], out: "y", name: "silu2"},
      {use: "vae_conv", args: {p: "fmt('{p}.conv2')"}, in: ["y"], out: "y", name: "conv2"},
      {op: "Binary", args: {kind: "Add"}, in: ["y", "v?:skip"], out: "out", name: "add", when: "has(fmt('{p}.conv_shortcut.weight'))"},
      {op: "Binary", args: {kind: "Add"}, in: ["y", "x"], out: "out", name: "add", when: "!has(fmt('{p}.conv_shortcut.weight'))"},
    ]},
    // Single-head self-attention `{p}` over all pixels of `x` [c, h, w] (1x1 `to_qkv` / `proj`
    // kernels as linears), residual.
    vae_attn: {params: ["x"], body: [
      {let: {c: "shape('x')[0]", hh: "shape('x')[1]", ww: "shape('x')[2]"}},
      {use: "rms_channels", args: {g: "fmt('{p}.norm.gamma')"}, in: ["x"], out: "y", name: "norm"},
      {op: "Reshape", args: {shape: ["c", "hh * ww"]}, in: ["y"], out: "y", name: "flat"},
      {op: "Transpose", args: {perm: [1, 0]}, in: ["y"], out: "y", name: "tok"},
      {op: "Linear", in: ["y", "w:{p}.to_qkv.weight", "w?:{p}.to_qkv.bias"], out: "qkv", name: "qkv"},
      {op: "Slice", args: {axis: 1, start: 0, end: "c"}, in: ["qkv"], out: "q", name: "q"},
      {op: "Slice", args: {axis: 1, start: "c", end: "2 * c"}, in: ["qkv"], out: "k", name: "k"},
      {op: "Slice", args: {axis: 1, start: "2 * c", end: "3 * c"}, in: ["qkv"], out: "v", name: "v"},
      {op: "Attention", args: {heads: 1, kv_heads: 1, causal: false}, in: ["q", "k", "v"], out: "a", name: "attn"},
      {op: "Linear", in: ["a", "w:{p}.proj.weight", "w?:{p}.proj.bias"], out: "o", name: "proj"},
      {op: "Transpose", args: {perm: [1, 0]}, in: ["o"], out: "o", name: "tb"},
      {op: "Reshape", args: {shape: ["c", "hh", "ww"]}, in: ["o"], out: "o", name: "unflat"},
      {op: "Binary", args: {kind: "Add"}, in: ["x", "o"], out: "out", name: "add"},
    ]},
  },
}

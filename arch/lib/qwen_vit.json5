// The Qwen3.5 / Qwen3-VL vision transformer (`model.visual.*`): pre-norm blocks with biased
// LayerNorms, fused qkv, 2D rotary (grid row, grid column) and attention over the whole image,
// GELU-tanh MLP; 2x2 patch mergers to the text width. Variables: v_hidden, v_heads, v_hd, v_merge;
// constant `vision.rope.inv_freq` ([v_hd / 2]: the row then the column frequencies); input
// `rope_positions` ([3 * patches]: row, col, 0).
{
  config: {
    // ---- vision tower (`model.visual.*`, `vision_config`); GGUF mmproj towers are not read ----
    has_vision: "has('model.visual.patch_embed.proj.weight')",
    // With a tower the decoder always rotates by `rope_positions` ([t, h, w] per row; text rows
    // put all three at the sequence position, so text-only prompts rotate as plain RoPE).
    mrope_variant: {MRope: {sections: "mrope_section", interleaved: true, pairs: "'Half'"}},
    v_hidden: "cfg.vision_config.hidden_size",
    v_heads: "cfg.vision_config.num_heads",
    v_hd: "v_hidden // v_heads",
    v_depth: "cfg.vision_config.depth",
    v_side: "int(sqrt(cfg.vision_config.num_position_embeddings))",
    v_patch: "cfg.vision_config.patch_size",
    v_temporal: "cfg.vision_config.temporal_patch_size",
    v_merge: "cfg.vision_config.spatial_merge_size",
    // Vision block each deepstack merger k reads; the decoder adds feature k after its layer k.
    deepstack_idx: "cfg.vision_config.deepstack_visual_indexes",
    deepstack_layers: "has_vision ? len(deepstack_idx) : 0",
  },
  checks: [
    {expr: "has_vision && cfg.vision_config.hidden_act != 'gelu_pytorch_tanh'", error: "vision hidden_act {cfg.vision_config.hidden_act} is not gelu_pytorch_tanh"},
    {expr: "has_vision && v_side * v_side != cfg.vision_config.num_position_embeddings",
     error: "num_position_embeddings {cfg.vision_config.num_position_embeddings} is not a square"},
    {expr: "has_vision && deepstack_layers > 3", error: "{deepstack_layers} deepstack layers; the spec wires at most 3"},
    {expr: "has_vision && deepstack_layers > 0 && max(deepstack_idx) >= v_depth",
     error: "deepstack index {max(deepstack_idx)} is past the {v_depth} vision blocks"},
  ],
  constants: {
    // ViT 2D rotary: a quarter of each head's pairs per axis, rows then columns.
    "vision.rope.inv_freq": {gen: "rope_inv_freq", when: "has_vision", args: {dim: "v_hd // 2", theta: 10000, precision: "'f32'", tile: 2}},
  },
  components: {
    // The ViT on one image's `grid_h x grid_w` patch grid (`smart_resize` patches, 2x2 merge-block
    // order): output `media` [patches / 4, hidden], then `deepstack.{k}` (same shape).
    vision: {
      vars: ["grid_h", "grid_w"],
      inputs: [
        {name: "patches", dtype: "f32", shape: ["grid_h * grid_w", "3 * v_temporal * v_patch * v_patch"]},
        // Bilinear (align-corners) taps of the `v_side`^2 learned position grid: rows, weights.
        {name: "pos_idx_0", dtype: "u32", shape: ["grid_h * grid_w"], gen: "bilinear_pos_taps",
         args: {grid_h: "grid_h", grid_w: "grid_w", merge: "v_merge", side: "v_side", corner: 0, output: "'index'"}},
        {name: "pos_idx_1", dtype: "u32", shape: ["grid_h * grid_w"], gen: "bilinear_pos_taps",
         args: {grid_h: "grid_h", grid_w: "grid_w", merge: "v_merge", side: "v_side", corner: 1, output: "'index'"}},
        {name: "pos_idx_2", dtype: "u32", shape: ["grid_h * grid_w"], gen: "bilinear_pos_taps",
         args: {grid_h: "grid_h", grid_w: "grid_w", merge: "v_merge", side: "v_side", corner: 2, output: "'index'"}},
        {name: "pos_idx_3", dtype: "u32", shape: ["grid_h * grid_w"], gen: "bilinear_pos_taps",
         args: {grid_h: "grid_h", grid_w: "grid_w", merge: "v_merge", side: "v_side", corner: 3, output: "'index'"}},
        {name: "pos_w_0", dtype: "f32", shape: ["grid_h * grid_w", 1], gen: "bilinear_pos_taps",
         args: {grid_h: "grid_h", grid_w: "grid_w", merge: "v_merge", side: "v_side", corner: 0, output: "'weight'"}},
        {name: "pos_w_1", dtype: "f32", shape: ["grid_h * grid_w", 1], gen: "bilinear_pos_taps",
         args: {grid_h: "grid_h", grid_w: "grid_w", merge: "v_merge", side: "v_side", corner: 1, output: "'weight'"}},
        {name: "pos_w_2", dtype: "f32", shape: ["grid_h * grid_w", 1], gen: "bilinear_pos_taps",
         args: {grid_h: "grid_h", grid_w: "grid_w", merge: "v_merge", side: "v_side", corner: 2, output: "'weight'"}},
        {name: "pos_w_3", dtype: "f32", shape: ["grid_h * grid_w", 1], gen: "bilinear_pos_taps",
         args: {grid_h: "grid_h", grid_w: "grid_w", merge: "v_merge", side: "v_side", corner: 3, output: "'weight'"}},
        {name: "rope_positions", dtype: "u32", shape: ["3 * grid_h * grid_w"], gen: "vision_rope_positions",
         args: {grid_h: "grid_h", grid_w: "grid_w", merge: "v_merge"}},
      ],
      body: [
        {op: "Linear", in: ["i:patches", "w:model.visual.patch_embed.proj.weight", "w?:model.visual.patch_embed.proj.bias"], out: "x", name: "patch_embed"},
        {repeat: "c", count: 4, body: [
          {op: "Embedding", in: ["w:model.visual.pos_embed.weight", "i:pos_idx_{c}"], out: "e", name: "pos_embed_{c}"},
          {op: "Binary", args: {kind: "'Mul'"}, in: ["e", "i:pos_w_{c}"], out: "e", name: "pos_scaled_{c}"},
          {op: "Binary", args: {kind: "'Add'"}, in: ["x", "e"], out: "x", name: "pos_add_{c}"},
        ]},
        {repeat: "b", count: "v_depth", body: [
          {use: "qwen_vit_block", args: {p: "fmt('model.visual.blocks.{b}')"}, in: ["x"], out: "x", name: "blocks.{b}"},
          {repeat: "k", count: "deepstack_layers", body: [
            {use: "qwen_vit_merger", args: {m: "fmt('model.visual.deepstack_merger_list.{k}')", post: true}, in: ["x"],
             out: "deepstack.{k}", name: "deepstack_merger.{k}", when: "at(deepstack_idx, k) == b"},
          ]},
        ]},
        {use: "qwen_vit_merger", args: {m: "'model.visual.merger'", post: false}, in: ["x"], out: "media", name: "merger"},
      ],
      outputs: [
        "media",
        {name: "deepstack.0", when: "deepstack_layers > 0"},
        {name: "deepstack.1", when: "deepstack_layers > 1"},
        {name: "deepstack.2", when: "deepstack_layers > 2"},
      ],
    },
  },
  runtime: {
    // `Qwen2VLImageProcessor`; placeholder expanded to the merged grid with get_rope_index's
    // [t, h, w] positions.
    media: {image: {
      when: "has_vision",
      component: "'vision'",
      preprocess: {kind: "'smart_resize'", patch: "v_patch", merge: "v_merge", temporal: "v_temporal",
                   min_pixels: "first(json.preprocessor_config.size.shortest_edge, json.preprocessor_config.min_pixels)",
                   max_pixels: "first(json.preprocessor_config.size.longest_edge, json.preprocessor_config.max_pixels)",
                   norm: {mean: "json.preprocessor_config.image_mean", std: "json.preprocessor_config.image_std"}},
      expand: {kind: "'merged_grid'", placeholder: "cfg.image_token_id"},
      positions: "'mrope_grid'",
    }},
  },
  macros: {
    // Block stem `p` on `x` [patches, v_hidden].
    qwen_vit_block: {params: ["x"], body: [
      {op: "LayerNorm", args: {eps: 1e-6}, in: ["x", "w:{p}.norm1.weight", "w?:{p}.norm1.bias"], out: "h", name: "norm1"},
      {op: "Linear", in: ["h", "w:{p}.attn.qkv.weight", "w?:{p}.attn.qkv.bias"], out: "qkv", name: "qkv"},
      {op: "Slice", args: {axis: -1, start: 0, end: "v_hidden"}, in: ["qkv"], out: "q", name: "q"},
      {op: "Slice", args: {axis: -1, start: "v_hidden", end: "2 * v_hidden"}, in: ["qkv"], out: "k", name: "k"},
      {op: "Slice", args: {axis: -1, start: "2 * v_hidden", end: "3 * v_hidden"}, in: ["qkv"], out: "v", name: "v"},
      {let: {rv: {MRope: {sections: ["v_hd // 4", "v_hd // 4", 0], interleaved: false, pairs: "'Half'"}}}},
      {op: "Rope", args: {head_dim: "v_hd", rotary_dim: "v_hd", variant: "rv", mscale: 1},
       in: ["q", "i:rope_positions", "c:vision.rope.inv_freq"], out: "q", name: "q_rope"},
      {op: "Rope", args: {head_dim: "v_hd", rotary_dim: "v_hd", variant: "rv", mscale: 1},
       in: ["k", "i:rope_positions", "c:vision.rope.inv_freq"], out: "k", name: "k_rope"},
      {op: "Attention", args: {heads: "v_heads", kv_heads: "v_heads", causal: false}, in: ["q", "k", "v"], out: "a", name: "attn"},
      {op: "Linear", in: ["a", "w:{p}.attn.proj.weight", "w?:{p}.attn.proj.bias"], out: "o", name: "proj"},
      {op: "Binary", args: {kind: "'Add'"}, in: ["x", "o"], out: "x", name: "add_attn"},
      {op: "LayerNorm", args: {eps: 1e-6}, in: ["x", "w:{p}.norm2.weight", "w?:{p}.norm2.bias"], out: "h", name: "norm2"},
      {op: "Linear", in: ["h", "w:{p}.mlp.linear_fc1.weight", "w?:{p}.mlp.linear_fc1.bias"], out: "h", name: "fc1"},
      {op: "Unary", args: {kind: "'GeluTanh'"}, in: ["h"], out: "h", name: "gelu"},
      {op: "Linear", in: ["h", "w:{p}.mlp.linear_fc2.weight", "w?:{p}.mlp.linear_fc2.bias"], out: "h", name: "fc2"},
      {op: "Binary", args: {kind: "'Add'"}, in: ["x", "h"], out: "out", name: "add_mlp"},
    ]},
    // Patch merger stem `m` on `x` [patches, d] in 2x2 merge-block order -> [patches / 4, out]:
    // LayerNorm (after the regroup to [patches / 4, 4d] when `post`, the deepstack mergers' order),
    // fc1, GELU, fc2.
    qwen_vit_merger: {params: ["x"], body: [
      {let: {rows: "shape('x')[0] // (v_merge * v_merge)", wide: "shape('x')[1] * v_merge * v_merge"}},
      {block: [
        {op: "Reshape", args: {shape: ["rows", "wide"]}, in: ["x"], out: "y", name: "regroup"},
        {op: "LayerNorm", args: {eps: 1e-6}, in: ["y", "w:{m}.norm.weight", "w?:{m}.norm.bias"], out: "y", name: "norm"},
      ], when: "post"},
      {block: [
        {op: "LayerNorm", args: {eps: 1e-6}, in: ["x", "w:{m}.norm.weight", "w?:{m}.norm.bias"], out: "y", name: "norm"},
        {op: "Reshape", args: {shape: ["rows", "wide"]}, in: ["y"], out: "y", name: "regroup"},
      ], when: "!post"},
      {op: "Linear", in: ["y", "w:{m}.linear_fc1.weight", "w?:{m}.linear_fc1.bias"], out: "h", name: "fc1"},
      {op: "Unary", args: {kind: "'GeluErf'"}, in: ["h"], out: "h", name: "gelu"},
      {op: "Linear", in: ["h", "w:{m}.linear_fc2.weight", "w?:{m}.linear_fc2.bias"], out: "out", name: "fc2"},
    ]},
  },
}

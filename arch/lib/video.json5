// Video-model building blocks (LTX-Video transformer / causal-3D VAE, ModelScope UNet3D).
// Weight stems (`w`) are canonical tensor names without `.weight` / `.bias`; biases optional.
{
  macros: {
    // `x @ {w}.weight^T (+ {w}.bias)`.
    lin: {params: ["x"], body: [
      {op: "Linear", in: ["x", "w:{w}.weight", "w?:{w}.bias"], out: "out"},
    ]},
    // `x * (1 + scale) + shift`; needs the constant `one` ([1], 1).
    modulate: {params: ["x", "shift", "scale"], body: [
      {op: "Binary", args: {kind: "Add"}, in: ["scale", "c:one"], out: "s1", name: "1p"},
      {op: "Binary", args: {kind: "Mul"}, in: ["x", "s1"], out: "m", name: "mul"},
      {op: "Binary", args: {kind: "Add"}, in: ["m", "shift"], out: "out", name: "shift"},
    ]},
    // Interleaved-pair rotation `x * cos + pair_swap(x) * sin` of `x [n, d]`, `sin` pair-signed
    // (`[-sin, +sin]` per pair).
    pair_rope: {params: ["x", "cos", "sin"], body: [
      {let: {n: "shape('x')[0]", d: "shape('x')[1]"}},
      {op: "Reshape", args: {shape: ["n * d / 2", 2]}, in: ["x"], out: "p", name: "pairs"},
      {op: "Slice", args: {axis: 1, start: 0, end: 1}, in: ["p"], out: "e", name: "even"},
      {op: "Slice", args: {axis: 1, start: 1, end: 2}, in: ["p"], out: "o", name: "odd"},
      {op: "Concat", args: {axis: 1}, in: ["o", "e"], out: "sw", name: "swap"},
      {op: "Reshape", args: {shape: ["n", "d"]}, in: ["sw"], out: "sw", name: "swapped"},
      {op: "Binary", args: {kind: "Mul"}, in: ["x", "cos"], out: "a", name: "cos"},
      {op: "Binary", args: {kind: "Mul"}, in: ["sw", "sin"], out: "c", name: "sin"},
      {op: "Binary", args: {kind: "Add"}, in: ["a", "c"], out: "out", name: "add"},
    ]},
  },
}

// Original Krea 2 / ComfyUI tensor names -> diffusers names (diffusers'
// `convert_krea2_transformer_checkpoint`), bare or under ComfyUI's `model.diffusion_model.` prefix.
// Block rules come before the bare `txtfusion.` prefix rule (first match wins).
{
  strip: ["model.diffusion_model."],
  rules: [
    ["blocks.{i}.attn.wq.{r:*}", "transformer_blocks.{i}.attn.to_q.{r}"],
    ["blocks.{i}.attn.wk.{r:*}", "transformer_blocks.{i}.attn.to_k.{r}"],
    ["blocks.{i}.attn.wv.{r:*}", "transformer_blocks.{i}.attn.to_v.{r}"],
    ["blocks.{i}.attn.wo.{r:*}", "transformer_blocks.{i}.attn.to_out.0.{r}"],
    ["blocks.{i}.attn.gate.{r:*}", "transformer_blocks.{i}.attn.to_gate.{r}"],
    ["blocks.{i}.attn.qknorm.qnorm.scale", "transformer_blocks.{i}.attn.norm_q.weight"],
    ["blocks.{i}.attn.qknorm.knorm.scale", "transformer_blocks.{i}.attn.norm_k.weight"],
    ["blocks.{i}.mlp.{r:*}", "transformer_blocks.{i}.ff.{r}"],
    ["blocks.{i}.prenorm.scale", "transformer_blocks.{i}.norm1.weight"],
    ["blocks.{i}.postnorm.scale", "transformer_blocks.{i}.norm2.weight"],
    ["blocks.{i}.mod.lin", "transformer_blocks.{i}.scale_shift_table"],
    ["txtfusion.{k:*}.{i}.attn.wq.{r:*}", "text_fusion.{k}.{i}.attn.to_q.{r}"],
    ["txtfusion.{k:*}.{i}.attn.wk.{r:*}", "text_fusion.{k}.{i}.attn.to_k.{r}"],
    ["txtfusion.{k:*}.{i}.attn.wv.{r:*}", "text_fusion.{k}.{i}.attn.to_v.{r}"],
    ["txtfusion.{k:*}.{i}.attn.wo.{r:*}", "text_fusion.{k}.{i}.attn.to_out.0.{r}"],
    ["txtfusion.{k:*}.{i}.attn.gate.{r:*}", "text_fusion.{k}.{i}.attn.to_gate.{r}"],
    ["txtfusion.{k:*}.{i}.attn.qknorm.qnorm.scale", "text_fusion.{k}.{i}.attn.norm_q.weight"],
    ["txtfusion.{k:*}.{i}.attn.qknorm.knorm.scale", "text_fusion.{k}.{i}.attn.norm_k.weight"],
    ["txtfusion.{k:*}.{i}.mlp.{r:*}", "text_fusion.{k}.{i}.ff.{r}"],
    ["txtfusion.{k:*}.{i}.prenorm.scale", "text_fusion.{k}.{i}.norm1.weight"],
    ["txtfusion.{k:*}.{i}.postnorm.scale", "text_fusion.{k}.{i}.norm2.weight"],
    ["txtfusion.{k:*}.{i}.mod.lin", "text_fusion.{k}.{i}.scale_shift_table"],
    ["first.{r:*}", "img_in.{r}"],
    ["tmlp.0.{r:*}", "time_embed.linear_1.{r}"],
    ["tmlp.2.{r:*}", "time_embed.linear_2.{r}"],
    ["tproj.1.{r:*}", "time_mod_proj.{r}"],
    ["txtmlp.0.scale", "txt_in.norm.weight"],
    ["txtmlp.1.{r:*}", "txt_in.linear_1.{r}"],
    ["txtmlp.3.{r:*}", "txt_in.linear_2.{r}"],
    ["txtfusion.{r:*}", "text_fusion.{r}"],
    ["last.linear.{r:*}", "final_layer.linear.{r}"],
    ["last.norm.scale", "final_layer.norm.weight"],
    ["last.modulation.lin", "final_layer.scale_shift_table"],
  ],
}

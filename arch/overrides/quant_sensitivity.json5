// Sensitive projection globs for ultra-low-bit / hybrid checkpoints where down_proj and routers
// require higher-precision re-encoding floors.
{
  applies_to: {
    family: ["qwen3", "qwen3_5", "qwen3_vl", "gemma3", "gemma4"],
  },
  patch: {
    runtime: {
      sensitive_weights: [
        "*.mlp.down_proj.weight",
        "*.mlp.gate.weight",
        "*.shared_expert_gate.weight",
        "lm_head.weight",
      ],
    },
  },
}
